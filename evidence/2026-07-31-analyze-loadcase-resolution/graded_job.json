  "ladder": [1.0],
  "margin_stop": 0.0,
  "simp": { "max_iterations": 4 },
  "lattice": { "topology": "octet", "emit_stl": true },
  "grading": {
    "topology": "octet",
    "cell_mm": 3.0,
    "min_extrudable_width_mm": 0.4,
    "demand_exponent": 1.0
  },
  "output": {
    "report": "report.json",
    "mesh_format": "stl",
    "mesh_prefix": "variant"
  }
