# THE ANALYTIC DESIGN: phi(x) = sum_i alpha_i psi(|x - x_i|_R).
# alpha is /tmp/plsmv/out/variant_026_alpha.f64, 7280 float64 in x-fastest knot order.
# Rebuild with topopt::plsm_make_lattice(nx, ny, nz, knots_vox..., support)
# then topopt::plsm_evaluate(lattice, basis, alpha, nx*F, ny*F, nz*F, F, threads);
# the ersatz is the VOLUME FRACTION of each cell inside {phi < 0}:
#   sample frac_samples^3 points per cell at
#     x = i + (p + 0.5)/k - 0.5   (the SAME lattice plsm_evaluate
#     uses at factor = k, so the two nest exactly)
#   and take the fraction with phi < 0 — mollified by the
#   quadrature band when frac_mollified (see plsm_frac.hpp).
#   FROZEN cells are STAMPED 1 / 0 by the mask, not sampled.
#   eta_voxels below does NOT enter this density.
basis gaussian
knots_vox 2 2 2
support_vox 4 4 4
counts 28 10 26
pad 2 2 2
n_coeff 7280
n_voxels 25344
compression 3.4813186813186814
eta_voxels 1
nx 48
ny 12
nz 44
spacing 4.5474114736916302
ox -18.275750737198241
oy -48.909974716000001
oz 0
requested_vf 0.26000000000000001
achieved_vf 0.25999998542257124
frozen_floor_occupancy 0.90915494309189537
ersatz fraction
sens_weight discrete
frac_samples 4
frac_cut_cells 64
frac_sample_wall_s 0.24018862238153815
frac_sens_wall_s 0.019895667210221291
stop_reason margin-plateau
margin_peak_iteration 4
margin_peak 5387.4743802170769
margin_probe_wall_s 3.632244043
# margin_probe: iteration margin load_path_ok — the CURVE the rule watched. R4: never a point.
margin_probe 4 5387.4743802170769 1
margin_probe 8 5387.6007017250531 1
margin_probe 12 5386.2216085893706 1
void_components 4
void_chi 3
void_enclosed_solid 0
void_sealed_pockets 0
void_tunnels 1
void_sealed_voxels 0
void_sealed_volume_mm3 0
void_voxels 1137
